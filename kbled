#!/usr/bin/env bash
# kbled - always-on keyboard backlight for the Unihertz Titan 2 / Titan 2 Elite
# (Agui keyboard stack), controllable from the stock Quick Settings tile.
set -euo pipefail

KBLED_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/common.sh
. "$KBLED_ROOT/lib/common.sh"

ACTION=""
TIMEOUT_MS="$KBLED_BIG_TIMEOUT"
BRIGHTNESS=""
START_WATCHER=1
FORCE=0

usage() {
  cat <<'EOF'
kbled - always-on keyboard backlight for the Titan 2 / Titan 2 Elite

Usage: kbled [options] [command]

Commands:
  install      apply the mod and start the watcher (default)
  uninstall    restore the original settings and remove the watcher
  status       show current settings and watcher state
  start        start the background watcher only
  stop         stop the background watcher only
  doctor       check that the device is supported
  version      print the version

Options:
  -s, --serial SERIAL    adb serial to target (or set KBLED_SERIAL)
  -h, --help             show this help

Options for 'install' only:
      --timeout-ms MS     timeout to write [default: 2147483647]
      --brightness N      LED brightness 0-100 (default: leave unchanged)
      --no-watcher        do not start the background watcher
  -f, --force             overwrite an existing backup when installing

Examples:
  ./kbled install
  ./kbled install --timeout-ms 3600000 --brightness 60
  ./kbled status
  ./kbled uninstall
EOF
}

# True when option $2 can be used with command $1.
kb_option_applies() {
  case "$2" in
    serial) [ "$1" != version ] ;;
    timeout | brightness | no-watcher | force) [ "$1" = install ] ;;
    *) return 1 ;;
  esac
}

parse_args() {
  local seen_serial=0 seen_timeout=0 seen_brightness=0 seen_no_watcher=0 seen_force=0
  local action_set=0

  while [ $# -gt 0 ]; do
    case "$1" in
      -s | --serial)
        [ $# -ge 2 ] || kb_usage_die "missing value for $1"
        KBLED_SERIAL=$2
        seen_serial=1
        shift 2
        ;;
      --serial=*)
        KBLED_SERIAL=${1#*=}
        seen_serial=1
        shift
        ;;
      --timeout-ms)
        [ $# -ge 2 ] || kb_usage_die "missing value for $1"
        TIMEOUT_MS=$2
        seen_timeout=1
        shift 2
        ;;
      --timeout-ms=*)
        TIMEOUT_MS=${1#*=}
        seen_timeout=1
        shift
        ;;
      --brightness)
        [ $# -ge 2 ] || kb_usage_die "missing value for $1"
        BRIGHTNESS=$2
        seen_brightness=1
        shift 2
        ;;
      --brightness=*)
        BRIGHTNESS=${1#*=}
        seen_brightness=1
        shift
        ;;
      --no-watcher)
        START_WATCHER=0
        seen_no_watcher=1
        shift
        ;;
      -f | --force)
        FORCE=1
        seen_force=1
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      -*) kb_usage_die "unknown option: $1" ;;
      *)
        if [ "$action_set" -ne 0 ]; then
          kb_usage_die "unexpected argument: $1 (the command is already '$ACTION')"
        fi
        ACTION=$1
        action_set=1
        shift
        ;;
    esac
  done

  case "$ACTION" in
    "" | install | apply | on) ACTION=install ;;
    uninstall | restore | revert | off) ACTION=uninstall ;;
    status | start | stop | doctor | version) : ;;
    *) kb_usage_die "unknown command: $ACTION" ;;
  esac

  if [ "$seen_serial" -eq 1 ]; then
    kb_option_applies "$ACTION" serial || kb_usage_die "--serial is not valid for '$ACTION'"
  fi
  if [ "$seen_timeout" -eq 1 ]; then
    kb_option_applies "$ACTION" timeout || kb_usage_die "--timeout-ms is not valid for '$ACTION'"
  fi
  if [ "$seen_brightness" -eq 1 ]; then
    kb_option_applies "$ACTION" brightness || kb_usage_die "--brightness is not valid for '$ACTION'"
  fi
  if [ "$seen_no_watcher" -eq 1 ]; then
    kb_option_applies "$ACTION" no-watcher || kb_usage_die "--no-watcher is not valid for '$ACTION'"
  fi
  if [ "$seen_force" -eq 1 ]; then
    kb_option_applies "$ACTION" force || kb_usage_die "--force is not valid for '$ACTION' (it only affects install)"
  fi

  if ! kb_int_in_range "$TIMEOUT_MS" 1 "$KBLED_BIG_TIMEOUT"; then
    kb_usage_die "--timeout-ms must be between 1 and $KBLED_BIG_TIMEOUT"
  fi
  if [ -n "$BRIGHTNESS" ]; then
    kb_int_in_range "$BRIGHTNESS" 0 100 || kb_usage_die "--brightness must be between 0 and 100"
  fi
  if [ -n "${KBLED_SERIAL:-}" ]; then
    kb_valid_serial "$KBLED_SERIAL" \
      || kb_usage_die "--serial may only contain letters, digits, '.', '_', '-' and ':'"
  fi

  # Normalise (007 -> 7) so the value read back from the device matches the
  # value that was written.
  TIMEOUT_MS=$(kb_decimal "$TIMEOUT_MS")
  if [ -n "$BRIGHTNESS" ]; then
    BRIGHTNESS=$(kb_decimal "$BRIGHTNESS")
  fi
}

do_install() {
  kb_require_tools
  kb_find_device
  kb_doctor

  local bf
  bf=$(kb_backup_file)
  if [ -f "$bf" ] && [ "$FORCE" -ne 1 ]; then
    kb_warn "a backup already exists at $bf"
    kb_warn "keeping it as the restore point (use --force to overwrite it)"
  else
    kb_save_backup "$bf"
    kb_ok "saved current settings to $bf"
  fi

  kb_write_key keyboard_brightness_timeout "$TIMEOUT_MS"
  kb_ok "keyboard_brightness_timeout = $TIMEOUT_MS"
  kb_write_key keyboard_brightness_timeout_backup "$TIMEOUT_MS"
  kb_ok "keyboard_brightness_timeout_backup = $TIMEOUT_MS"

  if [ -n "$BRIGHTNESS" ]; then
    kb_write_key keyboard_led_brightness "$BRIGHTNESS"
    kb_ok "keyboard_led_brightness = $BRIGHTNESS"
  fi

  kb_push_scripts "$KBLED_ROOT"

  if [ "$START_WATCHER" -eq 1 ]; then
    kb_shell "$KBLED_REMOTE_DIR/kbled_start.sh"
  else
    kb_warn "watcher not started (--no-watcher); the tile's OFF will apply on the next screen cycle"
  fi

  cat <<EOF

Done. Use the stock "keyboard_led" Quick Settings tile:

  tile ON   -> backlight stays on while the screen is on
  tile OFF  -> backlight switches off immediately
EOF
}

do_uninstall() {
  kb_require_tools
  kb_find_device

  local bf have_backup=0 tmo="$KBLED_DEFAULT_TIMEOUT" bak="$KBLED_DEFAULT_TIMEOUT" br=""
  bf=$(kb_backup_file)
  if [ -f "$bf" ]; then
    kb_backup_load "$bf" || kb_die "refusing to restore from an invalid backup file: $bf"
    have_backup=1
    tmo=${KBLED_BK_TIMEOUT:-$KBLED_DEFAULT_TIMEOUT}
    bak=${KBLED_BK_BACKUP:-$KBLED_DEFAULT_TIMEOUT}
    br=${KBLED_BK_BRIGHTNESS:-}
  fi

  kb_stop_watcher

  if [ "$have_backup" -eq 1 ]; then
    kb_write_key keyboard_brightness_timeout "$tmo"
    kb_write_key keyboard_brightness_timeout_backup "$bak"
    if [ -n "$br" ]; then
      kb_write_key keyboard_led_brightness "$br"
    fi
    kb_ok "restored original settings from $bf"
  else
    kb_warn "no backup found; resetting the timeout to the tool's own default of $KBLED_DEFAULT_TIMEOUT ms"
    kb_warn "this is not a guaranteed restore of the stock value (the vendor default is 5000 ms)"
    kb_write_key keyboard_brightness_timeout "$KBLED_DEFAULT_TIMEOUT"
    kb_write_key keyboard_brightness_timeout_backup "$KBLED_DEFAULT_TIMEOUT"
  fi

  kb_shell "rm -f $KBLED_REMOTE_DIR/kbled_watch.sh $KBLED_REMOTE_DIR/kbled_start.sh $KBLED_REMOTE_DIR/kbled_stop.sh $KBLED_REMOTE_DIR/kbled_watch.pid"
  kb_ok "removed device scripts"
}

do_status() {
  kb_require_tools
  kb_find_device

  local key val led pid
  for key in keyboard_brightness_timeout keyboard_brightness_timeout_backup \
    keyboard_led_brightness keyboard_led_auto_switch; do
    if val=$(kb_read_key "$key"); then
      printf '%-36s %s\n' "$key" "$(kb_strip_controls "$val")"
    else
      printf '%-36s %s\n' "$key" "unavailable (read failed)"
    fi
  done

  pid=$(kb_watcher_pid)
  if [ -n "$pid" ]; then
    printf '%-36s %s\n' "watcher" "running (pid $pid)"
  else
    printf '%-36s %s\n' "watcher" "not running"
  fi

  if led=$(kb_read_led); then
    printf '%-36s %s\n' "led" "$(kb_strip_controls "${led:-?}")"
  else
    printf '%-36s %s\n' "led" "unavailable (read failed)"
  fi
}

do_start() {
  kb_require_tools
  kb_find_device
  kb_push_scripts "$KBLED_ROOT"
  kb_shell "$KBLED_REMOTE_DIR/kbled_start.sh"
}

do_stop() {
  kb_require_tools
  kb_find_device
  kb_stop_watcher
}

do_doctor() {
  kb_require_tools
  kb_find_device
  kb_doctor
  kb_ok "device looks supported"
}

do_version() {
  printf 'kbled %s\n' "$KBLED_VERSION"
}

parse_args "$@"

# KBLED_SERIAL is consumed by the kb_* helpers in lib/common.sh.
: "${KBLED_SERIAL:-}"

case "$ACTION" in
  install) do_install ;;
  uninstall) do_uninstall ;;
  status) do_status ;;
  start) do_start ;;
  stop) do_stop ;;
  doctor) do_doctor ;;
  version) do_version ;;
esac
